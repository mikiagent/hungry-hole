[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

jolt_physics_3d/limits/max_bodies=32768
jolt_physics_3d/limits/max_body_pairs=131072
jolt_physics_3d/limits/max_contact_constraints=65536
jolt_physics_3d/limits/temporary_memory_buffer_size=128
3d/default_gravity=80.0

[rendering]
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.55, 0.8, 0.98, 1)

[internationalization]

locale/translations=PackedStringArray("res://translations/strings.en.translation")
