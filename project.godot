config_version=5

[application]
config/name="Hungry Hole"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
Events="*res://autoload/events.gd"
SaveData="*res://autoload/save_data.gd"
AudioManager="*res://autoload/audio_manager.gd"

[gui]

theme/custom="res://assets/fonts/game_theme.tres"
theme/custom_font="res://assets/fonts/fredoka_bold.tres"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/vsync/vsync_mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

