[layer_names]
3d_physics/layer_1="ground"
3d_physics/layer_2="objects"
3d_physics/layer_3="walls"
3d_physics/layer_4="holes"
3d_physics/layer_5="hole_floor"
3d_physics/layer_11="hole_rim_0"
3d_physics/layer_12="hole_rim_1"
3d_physics/layer_13="hole_rim_2"
